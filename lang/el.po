#, c-format
msgid "%s wasn't fully uninstalled"
msgstr "Το %s δεν απεγκαταστάθηκε πλήρως"

#: title/pc5_ui.c:6066
#, c-format
msgid "%s is uninstalled"
msgstr "Το %s απεγκαταστάθηκε"

