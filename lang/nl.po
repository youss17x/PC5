msgstr "Info"

#: title/pc5_ui.c:7668 title/pc5_ui.c:8442
msgid "Receive from phone"
msgstr "Ontvangen van telefoon"

#: title/pc5_ui.c:7696
msgid "Touchpad + OPTIONS for 2 s still leaves the game"
msgstr "Touchpad + OPTIONS 2 s lang verlaat de game nog steeds"

#: title/pc5_ui.c:7698
msgid "Two fingers: PC5's on-screen keyboard, or a key of its own"
msgstr "Twee vingers: het schermtoetsenbord van PC5, of een eigen toets"

#: title/pc5_ui.c:7701
msgid "A key for each half's click and each quick swipe"
msgstr "Een toets voor de klik op elke helft en voor elke snelle veeg"

#: title/pc5_ui.c:7702
