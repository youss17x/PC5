--- /dev/null
+++ b/wine/patches/0950-ddraw-ps5-setclipstatus-is-quiet.patch
@@ -0,0 +1,31 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: youss17x <youss17x@users.noreply.github.com>
+Date: Mon, 2 Nov 2026 21:29:26 +0000
+Subject: [PATCH] ddraw: PS5: SetClipStatus is quiet.
+
+Project IGI calls IDirect3DDevice7::SetClipStatus twice a frame. The stub
+returns D3D_OK and used to log a FIXME, which filled the log: the two calls
+pass different pointers, so only one of them collapsed. Nothing is stored.
+GetClipStatus is unchanged.
+---
+ dlls/ddraw/device.c | 4 +++-
+ 1 file changed, 3 insertions(+), 1 deletion(-)
+
+diff --git a/dlls/ddraw/device.c b/dlls/ddraw/device.c
+index 44f9973..60eeb0f 100644
+--- a/dlls/ddraw/device.c
++++ b/dlls/ddraw/device.c
+@@ -3779,7 +3779,9 @@ static HRESULT WINAPI d3d_device2_End(IDirect3DDevice2 *iface, DWORD flags)
+  *****************************************************************************/
+ static HRESULT WINAPI d3d_device7_SetClipStatus(IDirect3DDevice7 *iface, D3DCLIPSTATUS *clip_status)
+ {
+-    FIXME("iface %p, clip_status %p stub!\n", iface, clip_status);
++    /* PS5: quiet. Project IGI calls this twice a frame and the stub's FIXME filled
++     * the log. Nothing is stored; GetClipStatus is unchanged. */
++    TRACE("iface %p, clip_status %p.\n", iface, clip_status);
+ 
+     return D3D_OK;
+ }
+-- 
+2.39.5
+
