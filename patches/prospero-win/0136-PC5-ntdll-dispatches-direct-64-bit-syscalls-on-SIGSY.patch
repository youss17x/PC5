From d787a08ce0ff0b38ec2fbaaf7121a0c46e3b3364 Mon Sep 17 00:00:00 2001
From: youss17x <a.fzc17@gmail.com>
Date: Sun, 8 Nov 2026 22:31:14 +0100
Subject: [PATCH] PC5: ntdll translates direct syscalls to int 0x2e, reads
 debug registers, and allows SEH unwinding on pivoted frames

---
 ...tch-direct-64-bit-syscalls-on-sigsys.patch |  99 ++++++++++++++
 ...-a-thread-reads-back-debug-registers.patch | 121 ++++++++++++++++++
 ...ranslate-direct-syscalls-to-int-0x2e.patch | 108 ++++++++++++++++
 ...-seh-frames-outside-teb-stack-bounds.patch |  80 ++++++++++++
 4 files changed, 408 insertions(+)
 create mode 100644 wine/patches/1005-ntdll-ps5-dispatch-direct-64-bit-syscalls-on-sigsys.patch
 create mode 100644 wine/patches/1006-ntdll-ps5-a-thread-reads-back-debug-registers.patch
 create mode 100644 wine/patches/1007-ntdll-ps5-translate-direct-syscalls-to-int-0x2e.patch
 create mode 100644 wine/patches/1008-ntdll-ps5-allow-seh-frames-outside-teb-stack-bounds.patch

diff --git a/wine/patches/1005-ntdll-ps5-dispatch-direct-64-bit-syscalls-on-sigsys.patch b/wine/patches/1005-ntdll-ps5-dispatch-direct-64-bit-syscalls-on-sigsys.patch
new file mode 100644
index 0000000..9488793
--- /dev/null
+++ b/wine/patches/1005-ntdll-ps5-dispatch-direct-64-bit-syscalls-on-sigsys.patch
@@ -0,0 +1,99 @@
+From c41ecf7ede04a91f810fa5c95291bdd841314dcf Mon Sep 17 00:00:00 2001
+From: youss17x <a.fzc17@gmail.com>
+Date: Sun, 8 Nov 2026 18:20:03 +0100
+Subject: [PATCH 1/3] ntdll: Dispatch direct 64-bit syscalls on SIGSYS on PS5.
+
+---
+ dlls/ntdll/unix/signal_x86_64.c | 42 ++++++++++++++++++++++++++++++---
+ 1 file changed, 39 insertions(+), 3 deletions(-)
+
+diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
+index 8592cb4..f582a27 100644
+--- a/dlls/ntdll/unix/signal_x86_64.c
++++ b/dlls/ntdll/unix/signal_x86_64.c
+@@ -957,6 +957,7 @@ PW_NATIVE_SIGNAL_ENTRY( quit )
+ PW_NATIVE_SIGNAL_ENTRY( usr1 )
+ PW_NATIVE_SIGNAL_ENTRY( trap )
+ PW_NATIVE_SIGNAL_ENTRY( segv )
++PW_NATIVE_SIGNAL_ENTRY( sigsys )
+ #undef PW_NATIVE_SIGNAL_ENTRY
+ #define PW_SIGNAL_HANDLER(name) (pw_native_kernel.syscall ? pw_native_##name##_handler : name##_handler)
+ #else
+@@ -3443,13 +3444,16 @@ static void __attribute__((used)) usr1_handler( int signal, siginfo_t *siginfo,
+ }
+ 
+ 
+-#if defined(__APPLE__) || defined(__linux__)
++#if defined(__APPLE__) || defined(__linux__) || defined(__PROSPERO__)
+ /**********************************************************************
+  *		sigsys_handler
+  *
+  * Handler for SIGSYS, signals that a non-existent system call was invoked.
+  * On Mac, this is only called on macOS 14 Sonoma and later.
+  */
++#ifdef __PROSPERO__
++__attribute__((used))
++#endif
+ static void sigsys_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
+ {
+     extern const void *__wine_syscall_dispatcher_prolog_end_ptr;
+@@ -3457,6 +3461,34 @@ static void sigsys_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
+     struct thread_data *data = init_handler( sigcontext );
+     struct syscall_frame *frame = get_syscall_frame( data );
+ 
++#ifdef __PROSPERO__
++    if (RAX_sig(sigcontext) == 78 /* ENOSYS */ && RIP_sig(sigcontext) >= 24)
++    {
++        const BYTE *rip = (const BYTE *)(ULONG_PTR)RIP_sig(sigcontext);
++        if (*(const WORD *)(rip - 2) == 0x050f)
++        {
++            int offset;
++            for (offset = 7; offset <= 24; offset++)
++            {
++                if (rip[-offset] == 0xb8)
++                {
++                    DWORD id = *(const DWORD *)(rip - offset + 1);
++                    if (id < 0x3000)
++                    {
++                        RAX_sig(sigcontext) = id;
++                        EFL_sig(sigcontext) &= ~1;
++                        break;
++                    }
++                }
++            }
++        }
++    }
++    static LONG logged_sys;
++    if (InterlockedIncrement( &logged_sys ) <= 10)
++        MESSAGE( "wine-ps5: sigsys syscall id=0x%lx rip=%p\n",
++                 (long)RAX_sig(sigcontext), (void *)RIP_sig(sigcontext) );
++#endif
++
+     TRACE_(seh)("SIGSYS, rax %#lx, rip %#lx.\n", (long)RAX_sig(sigcontext), (long)RIP_sig(sigcontext));
+ 
+ #ifdef __linux__
+@@ -3481,6 +3513,10 @@ static void sigsys_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
+         frame->restore_flags |= CONTEXT_CONTROL;
+     }
+     RIP_sig(sigcontext) = (ULONG64)__wine_syscall_dispatcher_prolog_end_ptr;
++#ifdef __PROSPERO__
++    pw_set_host_fs( data, sigcontext );
++    leave_handler( data, sigcontext );
++#endif
+ }
+ #endif
+ 
+@@ -3713,8 +3749,8 @@ void signal_init_process( TEB *teb )
+     if (pw_native_sigaction( SIGSEGV, &sig_act, NULL ) == -1) goto error;
+     if (pw_native_sigaction( SIGILL, &sig_act, NULL ) == -1) goto error;
+     if (pw_native_sigaction( SIGBUS, &sig_act, NULL ) == -1) goto error;
+-#if defined(__APPLE__) || defined(__linux__)
+-    sig_act.sa_sigaction = sigsys_handler;
++#if defined(__APPLE__) || defined(__linux__) || defined(__PROSPERO__)
++    sig_act.sa_sigaction = PW_SIGNAL_HANDLER(sigsys);
+     if (pw_native_sigaction( SIGSYS, &sig_act, NULL ) == -1) goto error;
+ #endif
+ 
+-- 
+2.43.0
+
diff --git a/wine/patches/1006-ntdll-ps5-a-thread-reads-back-debug-registers.patch b/wine/patches/1006-ntdll-ps5-a-thread-reads-back-debug-registers.patch
new file mode 100644
index 0000000..376897c
--- /dev/null
+++ b/wine/patches/1006-ntdll-ps5-a-thread-reads-back-debug-registers.patch
@@ -0,0 +1,121 @@
+From 556294517d599bf62dc0b488045c1e10ce0a8c6d Mon Sep 17 00:00:00 2001
+From: youss17x <a.fzc17@gmail.com>
+Date: Sun, 8 Nov 2026 18:20:25 +0100
+Subject: [PATCH 2/3] ntdll: A thread reads back debug registers it set and
+ handles direct syscalls on int 0x2e.
+
+---
+ dlls/ntdll/unix/signal_x86_64.c | 74 +++++++++++++++++++++++++++++++++
+ 1 file changed, 74 insertions(+)
+
+diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
+index f582a27..5deb30c 100644
+--- a/dlls/ntdll/unix/signal_x86_64.c
++++ b/dlls/ntdll/unix/signal_x86_64.c
+@@ -1412,8 +1412,25 @@ NTSTATUS WINAPI NtGetContextThread( HANDLE handle, CONTEXT *context )
+ 
+     if (self && !frame) return STATUS_ACCESS_DENIED;
+ 
++#ifdef __PROSPERO__
++    /* The console has no debug registers a process can reach (no ptrace): the server cannot read them and
++     * answered without them, so the caller's buffer came back as it was (uninitialized stack garbage), which
++     * anti-debugging code reads as a debugger's breakpoints. A thread's own are the ones it set last. */
++    if (self && (needed_flags & CONTEXT_DEBUG_REGISTERS))
++    {
++        context->Dr0 = amd64_data->dr0;
++        context->Dr1 = amd64_data->dr1;
++        context->Dr2 = amd64_data->dr2;
++        context->Dr3 = amd64_data->dr3;
++        context->Dr6 = amd64_data->dr6;
++        context->Dr7 = amd64_data->dr7;
++        context->ContextFlags |= CONTEXT_DEBUG_REGISTERS;
++        needed_flags &= ~CONTEXT_DEBUG_REGISTERS;
++    }
++#else
+     /* debug registers require a server call */
+     if (needed_flags & CONTEXT_DEBUG_REGISTERS) self = FALSE;
++#endif
+ 
+     if (!self)
+     {
+@@ -1663,6 +1680,21 @@ NTSTATUS get_thread_wow64_context( HANDLE handle, void *ctx, ULONG size )
+ 
+     needed_flags = context->ContextFlags & ~CONTEXT_i386;
+ 
++#ifdef __PROSPERO__
++    /* As for a 64-bit thread (NtGetContextThread): the server cannot read debug registers here, and the values it
++     * did not give back also replaced the ones kept below. */
++    if (self && (needed_flags & CONTEXT_I386_DEBUG_REGISTERS))
++    {
++        context->Dr0 = amd64_data->dr0;
++        context->Dr1 = amd64_data->dr1;
++        context->Dr2 = amd64_data->dr2;
++        context->Dr3 = amd64_data->dr3;
++        context->Dr6 = amd64_data->dr6;
++        context->Dr7 = amd64_data->dr7;
++        context->ContextFlags |= CONTEXT_I386_DEBUG_REGISTERS;
++        needed_flags &= ~CONTEXT_I386_DEBUG_REGISTERS;
++    }
++#endif
+     /* debug registers require a server call */
+     if (needed_flags & CONTEXT_I386_DEBUG_REGISTERS) self = FALSE;
+ 
+@@ -2200,6 +2232,41 @@ static inline BOOL handle_interrupt( struct thread_data *data, ucontext_t *sigco
+ 
+     switch (ERROR_sig(sigcontext) >> 3)
+     {
++    case 0x2e:
++#ifdef __PROSPERO__
++        /* Direct 64-bit system call via int 0x2e (Windows interrupt syscall) on PS5. */
++        if (CS_sig(sigcontext) == cs64_sel)
++        {
++            extern const void *__wine_syscall_dispatcher_prolog_end_ptr;
++            struct syscall_frame *syscall_frame = get_syscall_frame( data );
++            ULONG64 next_rip = RIP_sig(sigcontext) + 2;
++
++            if (syscall_frame)
++            {
++                syscall_frame->rip = next_rip + 0xb;
++                syscall_frame->rcx = next_rip;
++                syscall_frame->eflags = EFL_sig(sigcontext);
++                syscall_frame->restore_flags = 0;
++                if (instrumentation_callback) syscall_frame->restore_flags |= RESTORE_FLAGS_INSTRUMENTATION;
++                if (EFL_sig(sigcontext) & 0x100)
++                {
++                    EFL_sig(sigcontext) &= ~0x100;
++                    syscall_frame->restore_flags |= CONTEXT_CONTROL;
++                }
++                RCX_sig(sigcontext) = (ULONG_PTR)syscall_frame;
++                R11_sig(sigcontext) = syscall_frame->eflags;
++            }
++            static LONG logged_2e;
++            if (InterlockedIncrement( &logged_2e ) <= 10)
++                MESSAGE( "wine-ps5: int 0x2e syscall id=0x%lx rip=%p -> next=%p\n",
++                         (long)RAX_sig(sigcontext), (void *)RIP_sig(sigcontext), (void *)next_rip );
++            RIP_sig(sigcontext) = (ULONG64)__wine_syscall_dispatcher_prolog_end_ptr;
++            pw_set_host_fs( data, sigcontext );
++            leave_handler( data, sigcontext );
++            return TRUE;
++        }
++#endif
++        break;
+     case 0x29:
+         /* __fastfail: process state is corrupted */
+         rec->ExceptionCode = STATUS_STACK_BUFFER_OVERRUN;
+@@ -3184,6 +3251,13 @@ static void __attribute__((used)) segv_handler( int signal, siginfo_t *siginfo,
+     }
+ #endif
+     if (handle_syscall_fault( data, sigcontext, &rec, &context.c )) return;
++#ifdef __PROSPERO__
++    static LONG logged_exc;
++    if (InterlockedIncrement( &logged_exc ) <= 10)
++        MESSAGE( "wine-ps5: exception 0x%lx at %p (trap %ld err 0x%lx)\n",
++                 (long)rec.ExceptionCode, (void *)RIP_sig(sigcontext),
++                 (long)TRAP_sig(sigcontext), (long)ERROR_sig(sigcontext) );
++#endif
+     setup_raise_exception( data, sigcontext, &rec, &context );
+ }
+ 
+-- 
+2.43.0
+
diff --git a/wine/patches/1007-ntdll-ps5-translate-direct-syscalls-to-int-0x2e.patch b/wine/patches/1007-ntdll-ps5-translate-direct-syscalls-to-int-0x2e.patch
new file mode 100644
index 0000000..fe2d44d
--- /dev/null
+++ b/wine/patches/1007-ntdll-ps5-translate-direct-syscalls-to-int-0x2e.patch
@@ -0,0 +1,121 @@
+From 6b3777cf4fb6c99a8b387e8a60ac830d8e6906cb Mon Sep 17 00:00:00 2001
+From: youss17x <a.fzc17@gmail.com>
+Date: Sun, 8 Nov 2026 23:50:06 +0100
+Subject: [PATCH] ntdll: Translate direct syscall instructions to int 0x2e on
+ PS5.
+
+---
+ dlls/ntdll/unix/virtual.c | 90 +++++++++++++++++++++++++++++++++++++++
+ 1 file changed, 90 insertions(+)
+
+diff --git a/dlls/ntdll/unix/virtual.c b/dlls/ntdll/unix/virtual.c
+index 7d1212d..fe2d44d 100644
+--- a/dlls/ntdll/unix/virtual.c
++++ b/dlls/ntdll/unix/virtual.c
+@@ -2358,6 +2358,87 @@ static DWORD get_win32_prot( BYTE vprot, unsigned int map_prot )
+  *
+  * Build page protections from Win32 flags.
+  */
++#ifdef __PROSPERO__
++/***********************************************************************
++ *           pw_translate_syscalls
++ *
++ * On PS5, user mode execution of the syscall instruction outside libkernel
++ * causes the kernel to immediately abort the process (SYSTEM_ILLEGAL_FUNCTION_CALL).
++ * Translate direct syscall instructions (0x0f 0x05) to int 0x2e (0xcd 0x2e), which
++ * triggers a #GP fault that Wine's interrupt handler catches and dispatches to
++ * __wine_syscall_dispatcher.
++ *
++ * To avoid any false positives in game code or data constants, strictly verify
++ * both preceding and following instruction boundaries:
++ * 1. Must be preceded within 16 bytes by mov $id, %eax (0xb8 xx xx 00 00 with id < 0x2000)
++ *    and/or mov %rcx, %r10 (0x4c 0x8b 0xd1 / 0x49 0x89 0xca).
++ * 2. Must be immediately followed by ret (0xc3), ret imm16 (0xc2), nop (0x90),
++ *    jmp short (0xeb), test %eax, %eax (0x85 0xc0), or add $imm8, %rsp (0x48 0x83 0xc4).
++ */
++static void pw_translate_syscalls( void *base, size_t size )
++{
++    unsigned char *p = (unsigned char *)base;
++    unsigned char *end = p + size - 2;
++
++    while (p <= end)
++    {
++        if (p[0] == 0x0f && p[1] == 0x05)
++        {
++            BOOL is_syscall = FALSE;
++            int k;
++            unsigned int syscall_id = 0;
++
++            /* Check following instruction: stub must return, jump or test return code */
++            if (p + 2 < (unsigned char *)base + size)
++            {
++                unsigned char next = p[2];
++                if (next == 0xc3 || next == 0xc2 || next == 0x90 || next == 0xeb ||
++                    (next == 0x85 && p + 3 < (unsigned char *)base + size && p[3] == 0xc0) ||
++                    (next == 0x48 && p + 4 < (unsigned char *)base + size && p[3] == 0x83 && p[4] == 0xc4))
++                {
++                    /* Preceding instruction must set syscall ID in %eax:
++                     * mov $id, %eax (0xb8 xx xx 00 00) with id < 0x2000 within 16 bytes */
++                    for (k = 5; k <= 16 && p - k >= (unsigned char *)base; k++)
++                    {
++                        if (p[-k] == 0xb8 && p - k + 4 < p)
++                        {
++                            unsigned int id = (unsigned int)p[-k + 1] | ((unsigned int)p[-k + 2] << 8);
++                            if (p[-k + 3] == 0 && p[-k + 4] == 0 && id < 0x2000)
++                            {
++                                is_syscall = TRUE;
++                                syscall_id = id;
++                                break;
++                            }
++                        }
++                    }
++
++                    /* Or preceded directly by mov %rcx, %r10 */
++                    if (!is_syscall && p - 3 >= (unsigned char *)base)
++                    {
++                        if ((p[-3] == 0x4c && p[-2] == 0x8b && p[-1] == 0xd1) ||
++                            (p[-3] == 0x49 && p[-2] == 0x89 && p[-1] == 0xca))
++                        {
++                            is_syscall = TRUE;
++                        }
++                    }
++                }
++            }
++
++            if (is_syscall)
++            {
++                p[0] = 0xcd;
++                p[1] = 0x2e;
++                MESSAGE( "wine-ps5: translated direct syscall at %p to int 0x2e (id=0x%x)\n", p, syscall_id );
++                p += 2;
++                continue;
++            }
++        }
++        p++;
++    }
++}
++#endif
++
++
+ static NTSTATUS get_vprot_flags( DWORD protect, unsigned int *vprot, BOOL image )
+ {
+     switch(protect & 0xff)
+@@ -2415,6 +2496,15 @@ static inline int mprotect_exec( void *base, size_t size, int unix_prot )
+         if (!(unix_prot & PROT_WRITE)) return -1;
+     }
+
++#ifdef __PROSPERO__
++    if ((unix_prot & PROT_EXEC) && size)
++    {
++        int can_write = (unix_prot & PROT_WRITE);
++        if (!can_write && !mprotect( base, size, unix_prot | PROT_WRITE )) can_write = 1;
++        if (can_write) pw_translate_syscalls( base, size );
++    }
++#endif
++
+     return mprotect( base, size, unix_prot );
+ }
+
+-- 
+2.43.0
+

diff --git a/wine/patches/1008-ntdll-ps5-allow-seh-frames-outside-teb-stack-bounds.patch b/wine/patches/1008-ntdll-ps5-allow-seh-frames-outside-teb-stack-bounds.patch
new file mode 100644
index 0000000..980b7d1
--- /dev/null
+++ b/wine/patches/1008-ntdll-ps5-allow-seh-frames-outside-teb-stack-bounds.patch
@@ -0,0 +1,80 @@
+From 856eee3d3f02b8056ce2b6caeaec5035f529ac86 Mon Sep 17 00:00:00 2001
+From: youss17x <a.fzc17@gmail.com>
+Date: Sun, 8 Nov 2026 22:30:51 +0100
+Subject: [PATCH] ntdll: Allow 64-bit SEH unwinding on frames outside TEB stack
+ limits.
+
+---
+ dlls/ntdll/ntdll_misc.h    | 12 ++++++++++++
+ dlls/ntdll/signal_x86_64.c | 18 ++++++++++++++++--
+ 2 files changed, 28 insertions(+), 2 deletions(-)
+
+diff --git a/dlls/ntdll/ntdll_misc.h b/dlls/ntdll/ntdll_misc.h
+index 2bf3cfa..6dfb207 100644
+--- a/dlls/ntdll/ntdll_misc.h
++++ b/dlls/ntdll/ntdll_misc.h
+@@ -68,6 +68,18 @@ static inline BOOL is_valid_frame( ULONG_PTR frame )
+             (void *)frame <= NtCurrentTeb()->Tib.StackBase);
+ }
+ 
++static inline BOOL is_valid_establisher_frame( ULONG_PTR frame )
++{
++    if (frame & (sizeof(void*) - 1)) return FALSE;
++    if ((void *)frame >= NtCurrentTeb()->Tib.StackLimit &&
++        (void *)frame <= NtCurrentTeb()->Tib.StackBase) return TRUE;
++#ifdef __x86_64__
++    return (frame >= 0x10000 && frame < (ULONG_PTR)0x7fffffffffffULL);
++#else
++    return FALSE;
++#endif
++}
++
+ extern void WINAPI LdrInitializeThunk(CONTEXT*,ULONG_PTR,ULONG_PTR,ULONG_PTR);
+ extern void WINAPI KiUserExceptionDispatcher(EXCEPTION_RECORD*,CONTEXT*);
+ extern void WINAPI KiUserApcDispatcher(CONTEXT*,ULONG_PTR,ULONG_PTR,ULONG_PTR,PNTAPCFUNC);
+diff --git a/dlls/ntdll/signal_x86_64.c b/dlls/ntdll/signal_x86_64.c
+index b94e4a2..0f13268 100644
+--- a/dlls/ntdll/signal_x86_64.c
++++ b/dlls/ntdll/signal_x86_64.c
+@@ -256,7 +256,7 @@ NTSTATUS call_seh_handlers( EXCEPTION_RECORD *rec, CONTEXT *orig_context )
+     unwind_done:
+         if (!dispatch.EstablisherFrame) break;
+ 
+-        if (!is_valid_frame( dispatch.EstablisherFrame ))
++        if (!is_valid_establisher_frame( dispatch.EstablisherFrame ))
+         {
+             ERR( "invalid frame %p (%p-%p)\n", (void *)dispatch.EstablisherFrame,
+                  NtCurrentTeb()->Tib.StackLimit, NtCurrentTeb()->Tib.StackBase );
+@@ -264,6 +264,20 @@ NTSTATUS call_seh_handlers( EXCEPTION_RECORD *rec, CONTEXT *orig_context )
+             break;
+         }
+ 
++#ifdef __PROSPERO__
++        if (dispatch.EstablisherFrame &&
++            ((void *)dispatch.EstablisherFrame < NtCurrentTeb()->Tib.StackLimit ||
++             (void *)dispatch.EstablisherFrame > NtCurrentTeb()->Tib.StackBase))
++        {
++            static LONG logged_pivoted_frame;
++            if (InterlockedIncrement( &logged_pivoted_frame ) <= 10)
++                MESSAGE( "wine-ps5: dispatching SEH on pivoted frame %p (stack %p-%p) handler %p\n",
++                         (void *)dispatch.EstablisherFrame,
++                         NtCurrentTeb()->Tib.StackLimit, NtCurrentTeb()->Tib.StackBase,
++                         dispatch.LanguageHandler );
++        }
++#endif
++
+         if (dispatch.LanguageHandler)
+         {
+             TRACE( "calling handler %p (rec=%p, frame=%I64x context=%p, dispatch=%p)\n",
+@@ -732,7 +746,7 @@ void WINAPI RtlUnwindEx( PVOID end_frame, PVOID target_ip, EXCEPTION_RECORD *rec
+     unwind_done:
+         if (!dispatch.EstablisherFrame) break;
+ 
+-        if (!is_valid_frame( dispatch.EstablisherFrame ))
++        if (!is_valid_establisher_frame( dispatch.EstablisherFrame ))
+         {
+             ERR( "invalid frame %p (%p-%p)\n", (void *)dispatch.EstablisherFrame,
+                  NtCurrentTeb()->Tib.StackLimit, NtCurrentTeb()->Tib.StackBase );
+-- 
+2.43.0
+
